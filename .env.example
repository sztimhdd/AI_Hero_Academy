# ──────────────────────────────────────────────────────────────────────────────
# AI Hero Academy — Local UAT environment template
# Copy this file to .env (gitignored) and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# Google Gemini API key (Phase A — LLM calls)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-key-here

# Google Cloud project for Firestore (Phase B — data layer)
# Run once: gcloud auth application-default login
GCP_PROJECT_ID=your-gcp-project-id

# UAT mode: activates test-user identity and sidebar UAT banner
# Change DEV_USER_EMAIL to any address — it becomes the isolated test user in Firestore.
# Run scripts/reset_uat_user.py to wipe this user's data between test passes.
LOCAL_UAT=true
DEV_USER_EMAIL=uat-test@edc.ca

# Phase C will add: GOOGLE_APPLICATION_CREDENTIALS (for Cloud Run service account)
