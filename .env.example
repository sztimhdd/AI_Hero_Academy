# ── Firebase client SDK (public — safe to expose to browser) ──────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=banded-totality-485901
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (server-only — NEVER expose to browser) ────────────────
FIREBASE_ADMIN_PROJECT_ID=banded-totality-485901
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private_key value from your service account JSON.
# Replace literal newlines with \n — the app will unescape them at runtime.
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Demo mode (private beta) ──────────────────────────────────────────────────
# When set, enables /demo?t=TOKEN for stakeholder walkthroughs.
# Store as GCP Secret Manager secret "demo-token" and reference in deploy.yml.
# Leave empty to disable demo mode entirely.
DEMO_TOKEN=

# ── Local UAT only (never set in production) ─────────────────────────────────
LOCAL_UAT=
