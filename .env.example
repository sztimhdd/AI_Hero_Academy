# ──────────────────────────────────────────────────────────────────────────────
# AI Hero Academy — Local UAT environment template
# Copy this file to .env (gitignored) and fill in your values.
#
# IMPORTANT: The Playwright/Chromium browser never talks to Databricks directly.
# Only the Streamlit Python process needs these credentials. A PAT here is
# sufficient for both SQL warehouse queries and AI serving endpoint calls.
# ──────────────────────────────────────────────────────────────────────────────

# Databricks PAT auth
# Generate at: Workspace → Settings → Developer → Access tokens → Generate new token
DATABRICKS_HOST=https://adb-2717931942638877.17.azuredatabricks.net/
DATABRICKS_TOKEN=dapi_replace_me

# SQL warehouse (Serverless Starter Warehouse — no change needed)
DATABRICKS_WAREHOUSE_ID=eaa098820703bf5f

# AI serving endpoint
SERVING_ENDPOINT_NAME=databricks-claude-sonnet-4-5

# Unity Catalog (no change needed)
UC_CATALOG=mdlg_ai_shared

# UAT mode: activates test-user identity and sidebar UAT banner
# Change DEV_USER_EMAIL to any address — it becomes the isolated test user in Delta tables.
# Run scripts/reset_uat_user.py to wipe this user's data between test passes.
LOCAL_UAT=true
DEV_USER_EMAIL=uat-test@edc.ca
