# Copy to .env for local development when running outside the VS Code extension.
# When using the Databricks VS Code extension, auth is handled automatically
# via the metadata service configured in .databricks/.databricks.env — you do
# not need a .env file for normal VS Code dev.

# Only needed when running streamlit outside the VS Code extension:
# DATABRICKS_HOST=https://adb-2717931942638877.17.azuredatabricks.net/
# DATABRICKS_TOKEN=<your-personal-access-token>

# App resource configuration (same values are set in app.yaml for the deployed app)
DATABRICKS_WAREHOUSE_ID=eaa098820703bf5f
SERVING_ENDPOINT_NAME=databricks-gemini-3-1-pro
UC_CATALOG=mdlg_ai
